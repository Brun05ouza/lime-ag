---
import SiteHeader from '../components/navigation/SiteHeader.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';
import '../styles/global.scss';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}
const { title, description, image = '/og/default.jpg', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const organizationId = new URL('/#organization', Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Lime Ag',
      url: Astro.site?.href,
      logo: new URL('/logos/lime-color-dark.webp', Astro.site).href,
      email: 'carol@limeagencia.com.br',
      telephone: '+55 21 97246-1018',
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      name: 'Lime Ag',
      url: Astro.site?.href,
      inLanguage: 'pt-BR',
      publisher: { '@id': organizationId },
    },
    {
      '@type': 'WebPage',
      '@id': canonical.href,
      url: canonical.href,
      name: title,
      description,
      inLanguage: 'pt-BR',
      isPartOf: { '@id': new URL('/#website', Astro.site).href },
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      document.documentElement.classList.add('js');
      window.setTimeout(() => {
        if (!document.documentElement.dataset.motionStatus) {
          document.documentElement.dataset.motionStatus = 'failed';
        }
      }, 4000);
    </script>
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="theme-color" content="#331335" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Lime Ag" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Lime Ag — Comunicação com estratégia e propósito" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
    ></script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Pular para o conteúdo
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <div class="cursor" aria-hidden="true" data-cursor><span>g</span></div>
    <script>
      import { initUI } from '../scripts/ui';
      import { bootMotion } from '../motion/reducedMotion';
      initUI();
      const disposeMotion = bootMotion();
      if (import.meta.hot) import.meta.hot.dispose(disposeMotion);
    </script>
  </body>
</html>
