---
interface Props {
  name: 'search' | 'plan' | 'launch' | 'growth';
}

const { name } = Astro.props;
---

<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  {name === 'search' && (
    <>
      <circle cx="13.5" cy="13.5" r="7.5" />
      <path d="m19 19 7 7" />
      <path d="M10.5 13.5h6M13.5 10.5v6" />
    </>
  )}
  {name === 'plan' && (
    <>
      <rect x="7" y="6" width="18" height="21" rx="2" />
      <path d="M12 6V4h8v2M11 12h10M11 17h10M11 22h6" />
      <path d="m8.5 12 1 1 2-2M8.5 17l1 1 2-2M8.5 22l1 1 2-2" />
    </>
  )}
  {name === 'launch' && (
    <>
      <path d="M13 20 6 22l4-7M19 13l-7 7M12 20l-2 6 6-2" />
      <path d="M14 18c-2-4 0-9 4-12 3-2 6-2 8-2 0 2 0 5-2 8-3 4-8 6-12 4Z" />
      <circle cx="21" cy="9" r="2" />
    </>
  )}
  {name === 'growth' && (
    <>
      <path d="M6 26h21M8 23v-6h4v6M15 23V12h4v11M22 23V8h4v15" />
      <path d="m8 12 6-5 5 2 7-6M22 3h4v4" />
    </>
  )}
</svg>
