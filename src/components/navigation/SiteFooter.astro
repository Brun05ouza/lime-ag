---
import LimeLogo from '../common/LimeLogo.astro';
import { navigation } from '../../data/navigation';
---

<footer class="site-footer">
  <div class="footer-inner wrap">
    <div class="footer-top">
      <a href="/" aria-label="Lime Ag, início">
        <LimeLogo large />
      </a>
      <p>
        Lime. Comunicação com estratégia.
        <br />
        Conexões com propósito.
      </p>
      <a href="#top" class="back-top">
        De volta ao topo <span aria-hidden="true">↑</span>
      </a>
    </div>
    <div class="footer-bottom">
      <small>© {new Date().getFullYear()} Lime Agência. Todos os direitos reservados.</small>
      <nav aria-label="Rodapé">
        {navigation.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
      <span class="footer-contacts">
        <a href="mailto:carol@limeagencia.com.br">carol@limeagencia.com.br</a>
        <a href="mailto:julia@limeagencia.com.br">julia@limeagencia.com.br</a>
      </span>
    </div>
  </div>
</footer>
