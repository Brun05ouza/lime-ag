---
import { navigation } from '../../data/navigation';
const whatsappUrl = `https://wa.me/5521972461018?text=${encodeURIComponent('Olá! Vim pelo site da Lime e gostaria de conversar sobre minha marca.')}`;
---

<footer class="site-footer">
  <div class="footer-inner wrap">
    <div class="footer-top">
      <a href="/" aria-label="Lime Ag, início">
        <span class="footer-logo"><img src="/logos/Lime-Ag-Logo-Versões-Vetor-2.png" alt="Lime Ag" width="1921" height="1081" loading="lazy" /></span>
      </a>
      <p>
        Lime. Comunicação com estratégia.
        <br />
        Conexões com propósito.
      </p>
      <div class="footer-socials" aria-label="Redes sociais">
        <button type="button" disabled aria-label="Instagram — link em breve" title="Instagram — link em breve">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          <span>Instagram</span>
        </button>
        <button type="button" disabled aria-label="LinkedIn — link em breve" title="LinkedIn — link em breve">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7.5 10v7M11.5 17v-7m0 3a3 3 0 0 1 6 0v4"/><circle cx="7.5" cy="7" r="1" fill="currentColor" stroke="none"/></svg>
          <span>LinkedIn</span>
        </button>
      </div>
    </div>
    <div class="footer-bottom">
      <nav aria-label="Rodapé">
        {navigation.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
      <small>© {new Date().getFullYear()} Lime Agência. Todos os direitos reservados.</small>
    </div>
  </div>
</footer>
<a class="whatsapp-float" href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="Conversar com a Lime pelo WhatsApp (abre em nova aba)" title="Conversar pelo WhatsApp">
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M20.52 3.48A11.91 11.91 0 0 0 12.04 0C5.46 0 .1 5.35.1 11.94c0 2.1.55 4.16 1.6 5.97L0 24l6.25-1.64a11.93 11.93 0 0 0 5.79 1.48h.01C18.63 23.84 24 18.49 24 11.9a11.87 11.87 0 0 0-3.48-8.42ZM12.05 21.83a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-3.71.97.99-3.61-.24-.37a9.88 9.88 0 0 1-1.52-5.29c0-5.47 4.45-9.92 9.93-9.92a9.84 9.84 0 0 1 7.02 2.91 9.85 9.85 0 0 1 2.9 7.02c0 5.47-4.45 9.88-9.96 9.88Zm5.45-7.43c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.08 4.49.71.3 1.27.48 1.7.62.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35Z"/>
  </svg>
</a>
