<section
  data-section-motion="finalmanifesto"
  class="final-manifesto section-pad"
  aria-label="Nosso propósito"
>
  <div class="wrap">
    <p class="eyebrow">O QUE FICA.</p>
    <div class="final-stage">
      <div class="final-stage-sticky">
        <p class="final-statement final-statement--setup" data-reveal="lines">
          <span class="final-line">Nós não criamos </span>
          <span class="final-line">conteúdo para </span>
          <span class="final-line"
            >preencher <span data-final-fill>espaços.</span></span
          >
        </p>
        <p class="final-statement final-statement--impact" data-reveal="lines">
          <span class="final-lead">
            <span class="final-line">Criamos </span>
            <span class="final-line">comunicação para </span>
            <span class="final-line">ocupar um lugar </span>
          </span>
          <span class="pink final-impact">
            <span class="final-impact-line" data-final-impact-block>
              <span data-final-mind>na mente</span><span class="final-conjunction"> e</span>
            </span>
            <span class="final-impact-line" data-final-impact-block>
              <span data-final-heart>no coração</span>
            </span>
            <span class="final-impact-line final-people" data-final-impact-block>
              das pessoas.
            </span>
          </span>
        </p>
      </div>
    </div>
    <div class="final-purpose">
      <p>
        Marcas inesquecíveis
        <br />
        não são as que falam mais.
      </p>
      <p class="display" data-reveal="lines">
        São as que falam
        <br />
        com{' '}
        <span class="pink" data-final-purpose>
          propósito.
        </span>
      </p>
    </div>
    <div class="final-pairs">
      <p>
        <span data-final-pair-lead>Comunicação sem estratégia</span>
        <br />
        <strong>é apenas ruído.</strong>
      </p>
      <p>
        <span data-final-pair-lead>Conexões sem propósito</span>
        <br />
        <strong>não geram negócios.</strong>
      </p>
    </div>
  </div>
</section>
