---
import { Picture } from 'astro:assets';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { cwd } from 'node:process';
import MetricCounter from '../ui/MetricCounter.astro';
import StrategyJourney from './StrategyJourney';
import { team } from '../../data/team';
import { metrics } from '../../data/metrics';
import { services } from '../../data/services';
import teamCrossedArms from '../../assets/team/equipe-lime.png';
import brandHands from '../../assets/editorial/brand-hands.png';
import heroMegaphone from '../../assets/editorial/hero-megaphone-cutout.png';
import { MANIFESTO_SOURCES } from '../../lib/manifesto';
const manifestoHasWebm = existsSync(join(cwd(), 'public', 'videos', 'manifesto-lime.webm'));
const manifestoHasMp4 = existsSync(join(cwd(), 'public', 'videos', 'manifesto-lime.mp4'));
const manifestoHasCaptions = existsSync(
  join(cwd(), 'public', 'videos', 'manifesto-lime.pt-BR.vtt'),
);
const manifestoVideoAvailable = manifestoHasWebm || manifestoHasMp4;
const marquee = [
  'Estratégia',
  'Branding',
  'Conteúdo',
  'Campanhas',
  'Performance',
  'Influência',
  'Inteligência',
  'Crescimento',
];
---

<div class="narrative" data-narrative-home>
  <div class="narrative-hero-stack">
    <section id="home" class="narrative-chapter narrative-hero" aria-labelledby="hero-title">
      <div class="narrative-wrap narrative-hero__grid">
        <div class="narrative-hero__copy">
          <h1 id="hero-title" data-narrative-reveal>
            <span class="narrative-hero__setup">
              Sua marca nunca
              <br />
              falou tanto.
            </span>
            <em>
              Mas ela está
              <br />
              sendo ouvida?
            </em>
          </h1>
          <p class="narrative-lead" data-narrative-reveal>
            Marcas inesquecíveis não são as que falam mais. São as que falam com propósito. A Lime
            cria comunicação para fortalecer marcas e gerar conexão.
          </p>
          <a class="narrative-link" href="#contato" data-narrative-reveal data-magnetic>
            <span data-button-label>Fale com a gente</span>
            <span class="button-arrow" aria-hidden="true">
              <span data-arrow-glyph>↗</span>
            </span>
          </a>
        </div>
        <div class="narrative-hero__portrait" data-narrative-reveal>
          <div class="narrative-hero__figure">
            <div class="narrative-hero__figure-layer narrative-hero__figure-layer--base">
              <Picture
                src={heroMegaphone}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                width={1100}
                widths={[520, 760, 1100]}
                sizes="(max-width: 767px) 92vw, 47vw"
                alt="Mulher em ilustração de meio-tom segurando um megafone"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <div
              class="narrative-hero__figure-layer narrative-hero__figure-layer--slice-a"
              aria-hidden="true"
            >
              <Picture
                src={heroMegaphone}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                width={1100}
                widths={[520, 760, 1100]}
                sizes="(max-width: 767px) 92vw, 47vw"
                alt=""
                loading="eager"
              />
            </div>
            <div
              class="narrative-hero__figure-layer narrative-hero__figure-layer--slice-b"
              aria-hidden="true"
            >
              <Picture
                src={heroMegaphone}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                width={1100}
                widths={[520, 760, 1100]}
                sizes="(max-width: 767px) 92vw, 47vw"
                alt=""
                loading="eager"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="narrative-marquee" aria-label={marquee.join(' · ')}>
      <div class="narrative-marquee__lane" aria-hidden="true">
        <div class="narrative-marquee__track">
          {[...marquee, ...marquee].map((item) => (
            <span>
              {item}
              <b>·</b>
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="narrative-manifesto-sequence">
    <section
      id="manifesto"
      class="narrative-chapter narrative-manifesto"
      aria-labelledby="manifesto-title"
      data-video-available={String(manifestoVideoAvailable)}
    >
      <div class="narrative-manifesto__stage">
        <div class="narrative-wrap narrative-manifesto__heading">
          <h2 id="manifesto-title">
            Comunicação não é volume. <em>É intenção.</em>
          </h2>
          <p class="narrative-manifesto__subtitle">Assista ao nosso manifesto:</p>
        </div>
        <div class="narrative-manifesto__media-anchor">
          <figure
            class:list={[
              'narrative-manifesto__media',
              { 'narrative-manifesto__media--video': manifestoVideoAvailable },
            ]}
          >
            <Picture
              src={brandHands}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              width={1920}
              widths={[720, 1200, 1600, 1920]}
              sizes="(max-width: 767px) 96vw, 92vw"
              alt="Mãos entrelaçadas em uma composição gráfica da Lime Ag"
              loading="lazy"
            />
            {manifestoVideoAvailable && (
              <video
                muted
                playsinline
                controls
                preload="metadata"
                poster={brandHands.src}
                disablepictureinpicture
                controlslist="nodownload nofullscreen noremoteplayback"
              >
                {manifestoHasWebm && <source src={MANIFESTO_SOURCES.webm} type="video/webm" />}
                {manifestoHasMp4 && <source src={MANIFESTO_SOURCES.mp4} type="video/mp4" />}
                {manifestoHasCaptions && (
                  <track
                    kind="captions"
                    src="/videos/manifesto-lime.pt-BR.vtt"
                    srclang="pt-BR"
                    label="Português"
                    default
                  />
                )}
              </video>
            )}
            <span class="narrative-manifesto__play" aria-hidden="true">
              <svg viewBox="0 0 32 32" focusable="false">
                <path d="M12 9.5 23 16l-11 6.5z" />
              </svg>
            </span>
          </figure>
        </div>
      </div>
    </section>
  </div>

  <section
    id="equipe"
    class="narrative-chapter narrative-founders"
    aria-labelledby="founders-title"
  >
    <div class="narrative-wrap narrative-content">
      <p class="narrative-kicker" data-narrative-reveal>
        As sócias
      </p>
      <h2 id="founders-title" data-narrative-reveal>
        Experiência de quem já fez grandes marcas <em>serem ouvidas.</em>
      </h2>
      <p class="narrative-intro" data-narrative-reveal>
        Mais do que serviços: a bagagem de quem já construiu resultados para grandes marcas
        nacionais e internacionais.
      </p>
      <div class="narrative-founders__grid">
        {team.map((person) => (
          <article class="narrative-founder" data-narrative-reveal>
            <div class="narrative-founder__photo">
              <Picture
                src={person.image}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                width={900}
                widths={[440, 700, 900]}
                sizes="(max-width: 767px) 90vw, 42vw"
                alt={person.name}
                loading="lazy"
              />
            </div>
            <div class="narrative-founder__body">
              <h3>{person.name}</h3>
              <p>{person.biography}</p>
              <p>{person.belief}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section
    id="resultados"
    class="narrative-chapter narrative-results"
    aria-labelledby="results-title"
  >
    <div class="narrative-wrap narrative-content">
      <p class="narrative-kicker" data-narrative-reveal>
        Experiência e resultados
      </p>
      <h2 id="results-title" data-narrative-reveal>
        O impacto da comunicação feita <em>com intenção.</em>
      </h2>
      <p class="narrative-intro" data-narrative-reveal>
        Campanhas, conteúdos e parcerias que se tornaram resultados concretos.
      </p>
      <div class="narrative-results__layout">
        <div class="narrative-results__image" data-narrative-reveal>
          <Picture
            src={teamCrossedArms}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            width={950}
            widths={[480, 760, 950]}
            sizes="(max-width: 767px) 90vw, 36vw"
            alt="Carol Melo e Julia Lima de braços cruzados"
            loading="lazy"
          />
        </div>
        <div class="narrative-results__metrics">
          {metrics.map((metric) => (
            <MetricCounter metric={metric} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section
    id="escopo"
    class="narrative-chapter narrative-expertise"
    aria-labelledby="expertise-title"
  >
    <div class="narrative-wrap narrative-content">
      <p class="narrative-kicker" data-narrative-reveal>
        O que fazemos
      </p>
      <h2 id="expertise-title" data-narrative-reveal>
        Onde a estratégia vira <em>presença e resultado.</em>
      </h2>
      <p class="narrative-intro" data-narrative-reveal>
        Pensar, criar, executar, analisar: tudo o que sua marca precisa para sair do ruído.
      </p>
      <div class="narrative-expertise__list">
        {services.map((service, index) => (
          <article class="narrative-expertise__item" data-narrative-reveal>
            <span>0{index + 1}</span>
            <div>
              <h3>{service.title}</h3>
              <p>{service.introduction}</p>
              <ul>
                {service.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <StrategyJourney client:load />

  <section id="contato" class="narrative-chapter narrative-contact" aria-labelledby="contact-title">
    <div class="narrative-wrap narrative-content">
      <p class="narrative-kicker" data-narrative-reveal>
        Vamos conversar
      </p>
      <h2 id="contact-title" data-narrative-reveal>
        Vamos transformar sua comunicação em <em>resultados reais?</em>
      </h2>
      <p class="narrative-intro" data-narrative-reveal>
        Conte um pouco sobre o momento da sua marca para começarmos uma conversa.
      </p>
      <form class="narrative-contact__form" data-contact-form>
        <div class="narrative-contact__fields">
          <label>
            Nome completo <span>*</span>
            <input
              name="name"
              autocomplete="name"
              placeholder="Ex.: Maria Silva"
              required
              maxlength="100"
            />
          </label>
          <label>
            Nome da empresa
            <input
              name="company"
              autocomplete="organization"
              placeholder="Ex.: Minha Empresa SA"
              maxlength="150"
            />
          </label>
          <label>
            E-mail corporativo <span>*</span>
            <input
              name="email"
              type="email"
              autocomplete="email"
              placeholder="Ex.: maria@empresa.com.br"
              required
              maxlength="254"
            />
          </label>
          <label>
            Celular
            <input
              name="phone"
              type="tel"
              autocomplete="tel"
              placeholder="Ex.: (21) 99999-9999"
              maxlength="30"
            />
          </label>
        </div>
        <input type="hidden" name="service" value="Contato pelo site" />
        <label>
          Mensagem <span>*</span>
          <textarea
            name="message"
            placeholder="Conte um pouco sobre sua marca e o que você quer destravar na comunicação."
            rows="3"
            required
            minlength="10"
            maxlength="5000"
          ></textarea>
        </label>
        <p class="narrative-contact__note">
          Ao clicar, sua mensagem será preparada no aplicativo de e-mail para você confirmar o
          envio.
        </p>
        <button
          class="narrative-contact__submit"
          type="submit"
          data-contact-submit
          data-magnetic
          disabled
        >
          <span data-button-label>Enviar mensagem</span>
          <span class="button-arrow" aria-hidden="true">
            <span data-arrow-glyph>↗</span>
          </span>
        </button>
        <p class="form-status" data-form-status role="status" aria-live="polite"></p>
        <noscript>
          <p>Para entrar em contato, escreva para carol@limeagencia.com.br.</p>
        </noscript>
      </form>
    </div>
  </section>
</div>
