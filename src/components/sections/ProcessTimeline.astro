---
import { process, nextSteps } from '../../data/process';
import SectionLabel from '../ui/SectionLabel.astro';
---

<section class="method section-pad" aria-labelledby="method-title">
  <div class="wrap">
    <SectionLabel number="06" text="COMO A GENTE FAZ" />
    <h2 id="method-title" class="display" data-reveal="lines">
      Assumindo
      <br />a estratégia.
    </h2>
    <div class="method-track">
      <div class="method-index" aria-hidden="true">
        <span data-method-number>01</span>
        <div class="method-progress">
          <i data-method-progress></i>
        </div>
        <span class="eyebrow">DA IMERSÃO À EVOLUÇÃO</span>
      </div>
      <ol class="method-steps">
        {process.map((step, i) => (
          <li data-method-step data-step={i + 1}>
            <span class="eyebrow">ETAPA 0{i + 1} / 04</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
<section class="next-steps section-pad wrap" aria-labelledby="next-title">
  <div class="section-heading">
    <h2 id="next-title" class="title-medium" data-reveal="lines">
      Da primeira conversa
      <br />à operação.
    </h2>
    <p>
      Começar pode ser simples.
      <br />A gente constrói junto.
    </p>
  </div>
  <ol>
    {nextSteps.map((step, i) => (
      <li>
        <span class="step-number">0{i + 1}</span>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>
</section>
