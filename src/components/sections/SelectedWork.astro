---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import SectionLabel from '../ui/SectionLabel.astro';
import CaseCard from '../ui/CaseCard.astro';
import megaphone from '../../assets/editorial/megaphone.png';
import socialDialogue from '../../assets/editorial/social-dialogue.png';
import handHeart from '../../assets/editorial/hand-heart.png';

const cases = (await getCollection('cases')).filter((entry) => entry.data.featured);
---

<section
  data-section-motion="work"
  id="trabalhos"
  class="work section-pad wrap"
  aria-labelledby="work-title"
>
  <SectionLabel number="08" text="NA PRÁTICA" />
  <div class="section-heading">
    <h2 id="work-title" class="display" data-reveal="lines">
      Estratégia
      <br />
      em movimento.
    </h2>
    <a class="text-link" href="/trabalhos/">
      Nossos trabalhos ↗
    </a>
  </div>
  {cases.length ? (
    cases.map((entry) => <CaseCard entry={entry} />)
  ) : (
    <div class="work-empty" data-work-story>
      <div class="work-collage" data-story-collage aria-label="Recortes do universo visual Lime">
        <div class="work-collage-layer work-collage-layer--social" data-story-layer="social">
          <Picture
            src={socialDialogue}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[480, 760, 1100]}
            sizes="(max-width: 639px) 100vw, (max-width: 1024px) 80vw, 58vw"
            alt="Composição gráfica de um celular com balões de conversa"
            loading="lazy"
          />
        </div>
        <div class="work-collage-layer work-collage-layer--megaphone" data-story-layer="megaphone">
          <Picture
            src={megaphone}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[240, 420, 640]}
            sizes="(max-width: 639px) 48vw, 24vw"
            alt="Megafone em retícula com explosão rosa"
            loading="lazy"
          />
        </div>
        <div class="work-collage-layer work-collage-layer--heart" data-story-layer="heart">
          <Picture
            src={handHeart}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[240, 420, 640]}
            sizes="(max-width: 639px) 44vw, 22vw"
            alt="Mão em retícula segurando um cartão com coração"
            loading="lazy"
          />
        </div>
      </div>
      <div class="work-empty-copy">
        <small>ARQUIVO VISUAL / SEM ATRIBUIÇÃO DE CLIENTE</small>
        <h3>
          <span data-story-line>Boas histórias</span>
          <span data-story-line>merecem ser</span>
          <span data-story-line>contadas por inteiro.</span>
        </h3>
        <p>
          Estamos preparando uma seleção dos nossos trabalhos.
          <br />
          Enquanto isso, vamos conversar sobre o seu próximo projeto?
        </p>
        <a class="work-story-cta" href="/contato/" data-magnetic>
          <span>Começar uma conversa</span>
          <i aria-hidden="true"></i>
          <b aria-hidden="true">↗</b>
        </a>
      </div>
    </div>
  )}
</section>
