---
import MagneticButton from '../ui/MagneticButton.astro';
---

<section
  data-section-wipe="black"
  data-section-motion="finalcta"
  id="contato"
  class="final-cta section-pad"
  aria-labelledby="contact-title"
>
  <div class="wrap">
    <p class="eyebrow">A PRÓXIMA CONEXÃO COMEÇA AQUI</p>
    <h2 id="contact-title" data-reveal="lines">
      Vamos transformar
      <br />
      sua comunicação
      <br />
      em resultado real?
    </h2>
    <MagneticButton href="/contato/" class="cta-large">
      Vamos conversar
    </MagneticButton>
  </div>
</section>
