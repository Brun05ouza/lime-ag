---
import MagneticButton from '../ui/MagneticButton.astro';
---

<section
  data-section-wipe="black"
  data-section-motion="finalcta"
  id="contato"
  class="final-cta section-pad"
  aria-labelledby="contact-title"
>
  <div class="wrap">
    <p class="eyebrow">A PRÓXIMA CONEXÃO COMEÇA AQUI</p>
    <h2 id="contact-title" data-reveal="lines">
      Vamos transformar
      <br />
      sua comunicação
      <br />
      em resultado real?
    </h2>
    <MagneticButton href="/contato/" class="cta-large">
      Vamos conversar
    </MagneticButton>
    <div class="contact-emails">
      <a class="text-link" href="mailto:julia@limeagencia.com.br" data-analytics="contact_click">
        julia@limeagencia.com.br ↗
      </a>
      <a class="text-link" href="mailto:carol@limeagencia.com.br" data-analytics="contact_click">
        carol@limeagencia.com.br ↗
      </a>
    </div>
  </div>
</section>
