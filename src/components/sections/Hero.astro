---
import LimeLine from '../common/LimeLine.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-intro wrap">
    <p class="eyebrow">
      LIME AG <span>MARKETING & COMMUNICATION</span>
    </p>
    <span class="hero-edition">ESTRATÉGIA QUE CONECTA.</span>
  </div>
  <div class="hero-type wrap">
    <h1 id="hero-title">
      <span class="hero-line" data-hero-line>
        Comunicação
      </span>
      <span class="hero-small" data-hero-line>
        com <span data-hero-strategy>estratégia.</span>
      </span>
      <span class="hero-line hero-line--second" data-hero-line>
        Conexões
      </span>
      <span class="hero-small hero-small--second" data-hero-line>
        <span data-hero-purpose>com propósito.</span>
      </span>
    </h1>
  </div>
  <LimeLine id="hero-gradient" />
  <div class="hero-bottom wrap">
    <a class="scroll-cue" href="#intencao">
      <span aria-hidden="true">↓</span> Conheça a Lime
    </a>
    <p>
      Estratégia, criatividade e performance trabalhando juntas para transformar comunicação em
      valor para marcas.
    </p>
    <a class="text-link" href="#escopo">
      Ver o que fazemos <span aria-hidden="true">↘</span>
    </a>
  </div>
</section>
