      >
        <stop stop-color="#FD3068" />
        <stop offset="1" stop-color="#F27E3B" />
      </linearGradient>
    </defs>
    <path
      data-lime-path
      d="M-120 730C130 930 395 758 535 580C704 367 856 319 1028 367C1251 429 1390 275 1230 196C1070 117 949 297 1110 366C1255 428 1380 257 1530 90"
