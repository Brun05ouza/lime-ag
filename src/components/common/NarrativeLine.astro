---
interface Props {
  chapter:
    | 'home'
    | 'manifesto'
    | 'statement'
    | 'founders'
    | 'results'
    | 'expertise'
    | 'process'
    | 'contact';
}
const { chapter } = Astro.props;
// Paths com tangentes contínuas. Desktop evita o bloco de texto (fica atrás
// da mídia / no respiro). Mobile corre ao lado da coluna tipográfica.
const paths = {
  home: [
    // Curva viva no hero; no marquee só um leve desvio (mesma linha, sem régua).
    'M920 70 C 920 170, 780 200, 755 300 C 725 420, 855 470, 885 560 C 910 650, 875 720, 855 780 C 842 840, 848 900, 858 1000',
    'M360 55 C 360 180, 320 255, 320 360 C 320 470, 355 600, 350 780 C 348 860, 352 930, 358 1000',
  ],
  manifesto: [
    // Entra na tangente do hero (~858) e sai suave à direita, sem chicote de volta.
    'M858 0 C 858 110, 850 220, 820 330 C 775 470, 730 540, 755 650 C 790 780, 860 860, 885 1000',
    'M358 0 C 358 140, 340 280, 330 420 C 320 560, 300 640, 310 760 C 320 880, 350 960, 360 1000',
  ],
  statement: [
    // Continua ~885 com S orgânico até 400 (sem diagonal “de régua”).
    'M885 0 C 900 100, 910 200, 880 320 C 840 460, 720 560, 600 680 C 500 780, 420 880, 400 1000',
    'M360 0 C 360 400, 350 600, 330 740 C 310 840, 300 900, 330 950 C 350 980, 360 990, 360 1000',
  ],
  founders: [
    // Entra em 400 com tangente próxima da saída do statement; arco interno (sem clip na borda).
    'M400 0 C 400 70, 480 120, 620 180 C 780 250, 900 330, 915 470 C 928 600, 880 720, 790 840 C 710 930, 560 980, 500 1000',
    'M360 0 C 360 210, 310 320, 310 450 C 310 580, 355 700, 355 800 C 355 890, 360 950, 360 1000',
  ],
  results: [
    'M500 0 C 500 90, 900 120, 910 230 C 920 320, 800 340, 790 420 C 780 500, 930 520, 940 620 C 950 740, 910 820, 920 1000',
    'M360 0 C 360 220, 320 340, 320 480 C 320 630, 360 760, 360 1000',
  ],
  expertise: [
    'M920 0 C 920 130, 840 180, 840 340 C 840 470, 930 520, 930 650 C 930 760, 840 800, 840 860 C 840 930, 380 950, 360 1000',
    'M360 0 C 360 220, 310 340, 310 480 C 310 640, 350 760, 350 880 C 350 940, 360 970, 360 1000',
  ],
  process: [
    // Bola caindo: esquerda → direita → esquerda → direita, no vão entre os cards.
    // A partir de ~y840 já está vertical em 985 e segue além da seção (emenda no contato).
    'M360 0 C 480 35, 700 80, 820 150 C 900 210, 900 270, 870 340 C 840 420, 420 470, 200 520 C 70 545, 90 560, 220 575 C 360 600, 720 630, 900 680 C 980 720, 990 770, 985 820 C 985 940, 985 1040, 985 1140',
    'M340 0 C 300 120, 80 180, 90 280 C 100 380, 300 420, 310 520 C 320 620, 80 680, 90 780 C 100 860, 280 920, 320 1000',
  ],
  contact: [
    // Mesma vertical 985 do processo; só depois curva.
    'M985 0 C 985 140, 985 260, 960 400 C 920 560, 780 700, 580 820 C 440 900, 340 960, 280 1000',
    'M320 0 C 320 280, 300 620, 280 800 C 260 880, 220 930, 180 980',
  ],
} as const;
const [desktop, mobile] = paths[chapter];
---

<div class:list={['narrative-line', `narrative-line--${chapter}`]} aria-hidden="true">
  <svg
    class="narrative-line__desktop"
    viewBox="0 0 1000 1000"
    preserveAspectRatio="none"
    fill="none"
  >
    <path data-narrative-path d={desktop} />
  </svg>
  <svg class="narrative-line__mobile" viewBox="0 0 400 1000" preserveAspectRatio="none" fill="none">
    <path data-narrative-path d={mobile} />
  </svg>
</div>
