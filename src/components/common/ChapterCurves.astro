---
interface Props {
  id: string;
  variant: 'left' | 'right';
  shape?: 'arc' | 'sweep';
}
const { id, variant, shape = 'arc' } = Astro.props;
// Open brand curves extend past the edge without knots or visible end caps.
const arc =
  variant === 'right'
    ? 'M280 20 C190 20 120 60 120 120 C120 180 190 220 280 220'
    : 'M-40 20 C50 20 120 60 120 120 C120 180 50 220 -40 220';
const sweep =
  variant === 'right'
    ? 'M280 15 C190 15 160 205 280 225'
    : 'M-40 15 C50 15 80 205 -40 225';
const route = shape === 'sweep' ? sweep : arc;
---

<div class={`chapter-curves chapter-curves--${variant}`} aria-hidden="true">
  <svg
    viewBox="0 0 240 240"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
    data-chapter-curve
    data-curve-shape={shape}
  >
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="240" y2="240" gradientUnits="userSpaceOnUse">
        <stop stop-color="var(--lime-pink)" />
        <stop offset="1" stop-color="var(--lime-orange)" />
      </linearGradient>
    </defs>
    <path d={route} pathLength="1" vector-effect="non-scaling-stroke" stroke={`url(#${id})`} />
  </svg>
</div>
