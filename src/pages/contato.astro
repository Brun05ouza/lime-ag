---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
---

<BaseLayout
  title="Contato — Vamos conversar | Lime Ag"
  description="Conte os desafios da sua marca. Converse com Carol Melo e Julia Lima para transformar sua comunicação em resultado real."
>
  <header class="page-hero">
    <div class="wrap">
      <p class="eyebrow">LIME AG / A PRÓXIMA CONEXÃO</p>
      <h1>
        Vamos
        <br />
        conversar<span class="pink">?</span>
      </h1>
      <p>
        Conte onde sua marca está.
        <br />
        Vamos pensar juntos em onde ela pode chegar.
      </p>
    </div>
  </header>
  <section class="contact-page section-pad wrap" aria-labelledby="form-title">
    <div class="contact-aside">
      <h2 id="form-title">
        Seu próximo
        <br />
        capítulo começa aqui.
      </h2>
      <p>Prefere uma conversa direta?</p>
      <a class="text-link" href="mailto:julia@limeagencia.com.br" data-analytics="contact_click">
        julia@limeagencia.com.br ↗
      </a>
      <a class="text-link" href="mailto:carol@limeagencia.com.br" data-analytics="contact_click">
        carol@limeagencia.com.br ↗
      </a>
    </div>
    <form data-contact-form>
      <div class="form-grid">
        <label>
          Nome <span aria-hidden="true">*</span>
          <input name="name" autocomplete="name" required maxlength="100" />
        </label>
        <label>
          Empresa
          <input name="company" autocomplete="organization" maxlength="150" />
        </label>
        <label>
          E-mail <span aria-hidden="true">*</span>
          <input name="email" type="email" autocomplete="email" required maxlength="254" />
        </label>
        <label>
          WhatsApp
          <input name="phone" type="tel" autocomplete="tel" maxlength="30" />
        </label>
      </div>
      <label>
        Serviço
        <select name="service">
          <option value="">Selecione um serviço</option>
          {services.map((service) => (
            <option>{service.title}</option>
          ))}
          <option>Outro</option>
        </select>
      </label>
      <label>
        Como podemos ajudar? <span aria-hidden="true">*</span>
        <textarea name="message" rows="4" required minlength="10" maxlength="5000"></textarea>
      </label>
      <p class="form-note">
        Ao enviar, abriremos seu aplicativo de e-mail com a mensagem preparada. Você confere e
        conclui o envio por lá.
      </p>
      <button class="button" type="submit" data-contact-submit disabled>
        <span>Enviar projeto</span>
        <span aria-hidden="true">↗</span>
      </button>
      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
      <noscript>
        <p>
          Para enviar seu projeto, escreva para{' '}
          <a href="mailto:julia@limeagencia.com.br">julia@limeagencia.com.br</a>.
        </p>
      </noscript>
    </form>
  </section>
</BaseLayout>
