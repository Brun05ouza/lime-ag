import Manifesto from '../components/sections/Manifesto.astro';
import VisualInterlude from '../components/sections/VisualInterlude.astro';
import Results from '../components/sections/Results.astro';
import ServiceExplorer from '../components/sections/ServiceExplorer.astro';
import StrategicPartner from '../components/sections/StrategicPartner.astro';
